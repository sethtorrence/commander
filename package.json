{
  "name": "commander",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter @commander/desktop dev",
    "build": "pnpm --filter @commander/desktop build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @commander/desktop test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
